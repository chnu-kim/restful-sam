{
  "name": "restful-sam",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "seed:sql": "node scripts/seed-sql.mjs",
    "deploy": "npm test && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "serve": "node tests/e2e/server.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  }
}
