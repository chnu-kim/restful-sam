{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "restful-sam",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "account_id": "fc7323801136ae087db0b88ab4d07b53",
  "workers_dev": true,
  // 정적 페이지는 public/만 올린다. /data/*는 D1의 최신 기록을 내보내고, /는 링크 카드 메타를 넣도록 Worker가 먼저 처리한다
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/data/*", "/"]
  },
  // 링크 카드 이미지를 찍는 Browser Run (무료 플랜 하루 10분, 카드가 바뀔 때만 찍어 하루 몇 번이면 된다)
  "browser": { "binding": "BROWSER" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restful-sam",
      "database_id": "8c6dc752-8fa2-4514-8a06-ff3bdf4acf0f",
      "migrations_dir": "migrations"
    }
  ],
  // 1분마다 방송 상태 수집
  "triggers": { "crons": ["* * * * *"] },
  // 로그와 트레이스. 무료 한도(하루 20만 건)에 비해 사용량(하루 1만 건 남짓)이 작아 전부 남긴다
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
